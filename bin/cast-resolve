#!/usr/bin/env bash
# cast-resolve — pick which Chromecast to cast to, deterministically and per-LAN.
#
# Both helpers (cast-mirror, cast-screen) call this instead of grabbing the first
# device that answers `catt scan`. It identifies the current LAN by the default
# gateway's MAC address (stable across DHCP churn, works on wifi+ethernet, immune
# to docker/virbr/tailscale interfaces), looks that key up in devices.json, and
# falls back through a strict precedence ladder. It NEVER silently picks the first
# of several devices — on ambiguity it exits 3 and lists the candidates so the
# interactive layer (the skill) can ask the user.
#
# Subcommands:
#   (none)                resolve + print the device NAME (for `catt -d`)
#   --ip                  resolve + print the device IP   (for the native sender)
#   register [name] [--label L]
#                         map THIS LAN -> name in devices.json (atomic) and sync
#                         catt's own default (catt -d <name> set_default)
#   list                  show fingerprint, config, and scan candidates
#
# Precedence (first match wins):
#   1. explicit override   $CAST_DEVICE env or --device <name>
#   2. network match       gateway-MAC key present in devices.json .networks
#   3. global default      devices.json .default_device
#   4. single-device auto  exactly one device on `catt scan`
#   5. ambiguous           >=2 devices, no preference -> exit 3 (fail loud)
#
# Exit codes: 0 ok | 2 usage | 3 ambiguous | 4 no devices on LAN
#             5 preferred device not present on this LAN
#
# Deps: catt, jq, ip (iproute2), ping (iputils) — all already present. No new deps.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/skill_cast"
CONFIG="$CONFIG_DIR/devices.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/skill_cast"
SCAN_CACHE="$STATE_DIR/scan-cache.json"
SCAN_TTL=15                                   # seconds; catt scan is the slow part
CATT_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/catt/catt.cfg"
CATT="$(command -v catt || echo "$HOME/.local/bin/catt")"

log() { printf '%s\n' "$*" >&2; }
die() { log "cast-resolve: $*"; exit "${2:-1}"; }
have() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# --- network fingerprint ----------------------------------------------------

# Identify the current LAN by the default gateway's MAC. Prints "gw:<mac>" (lower-
# case) or "unknown". Derived ONLY from the default route, so VPN/bridge/docker
# interfaces can never masquerade as the LAN.
fingerprint() {
  local gw dev mac
  read -r gw dev < <(ip -json route show default 2>/dev/null \
    | jq -r 'sort_by(.metric // 0)[0] | "\(.gateway // "") \(.dev // "")"')
  [[ -z "$gw" || "$gw" == "null" ]] && { printf 'unknown'; return; }

  # Tailscale exit-node / tunnel as default route -> not a physical LAN. Skip,
  # so we fall through to the global default instead of minting a bogus key.
  if [[ "$dev" == tailscale* || "$dev" == tun* || "$dev" == wg* ]] \
    || [[ "$gw" =~ ^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\. ]]; then
    printf 'unknown'
    return
  fi

  mac="$(ip -json neigh show to "$gw" dev "$dev" 2>/dev/null \
    | jq -r 'map(select(.lladdr))[0].lladdr // ""')"
  # Cold/STALE/FAILED neigh cache: prime once with a single probe, then re-read.
  # STALE still carries a valid lladdr — only an ABSENT lladdr is a real miss.
  if [[ -z "$mac" ]]; then
    ping -c1 -W1 "$gw" >/dev/null 2>&1 || true
    mac="$(ip -json neigh show to "$gw" dev "$dev" 2>/dev/null \
      | jq -r 'map(select(.lladdr))[0].lladdr // ""')"
  fi
  [[ -z "$mac" ]] && { printf 'unknown'; return; }
  printf 'gw:%s' "$(printf '%s' "$mac" | tr 'A-Z' 'a-z')"
}

# --- config -----------------------------------------------------------------

# catt.cfg "device =" value (used only to seed devices.json on first run).
catt_default() {
  [[ -f "$CATT_CFG" ]] || return 0
  sed -n 's/^[[:space:]]*device[[:space:]]*=[[:space:]]*\(.*\)$/\1/p' "$CATT_CFG" \
    | head -1 | sed 's/[[:space:]]*$//'
}

# Materialize devices.json (seeded from catt.cfg) if it doesn't exist yet.
ensure_config() {
  [[ -f "$CONFIG" ]] && return 0
  mkdir -p "$CONFIG_DIR"
  local seed; seed="$(catt_default)"
  jq -n --arg d "$seed" \
    '{version:1, default_device:$d, networks:{}}' > "$CONFIG"
  log "cast-resolve: created $CONFIG (default_device='${seed:-<none>}')"
}

# Atomic write: jq filter applied to $CONFIG, replaced via rename(2).
config_write() {
  local tmp; tmp="$(mktemp "$CONFIG_DIR/.devices.XXXXXX.json")"
  if jq "$@" "$CONFIG" > "$tmp"; then
    mv -f "$tmp" "$CONFIG"
  else
    rm -f "$tmp"; die "failed to update $CONFIG"
  fi
}

cfg_network_device() { jq -r --arg k "$1" '.networks[$k].device // ""' "$CONFIG"; }
cfg_default_device() { jq -r '.default_device // ""' "$CONFIG"; }

# --- scan (cached) ----------------------------------------------------------

# Refresh the name->ip scan cache if older than TTL. catt scan lines look like:
#   192.168.1.228 - 43PUS9235/12 - Philips TPM191E
scan_refresh() {
  local age=$((SCAN_TTL + 1))
  if [[ -f "$SCAN_CACHE" ]]; then
    age=$(( $(date +%s) - $(stat -c %Y "$SCAN_CACHE") ))
  fi
  [[ "$age" -lt "$SCAN_TTL" ]] && return 0

  mkdir -p "$STATE_DIR"
  local tmp; tmp="$(mktemp "$STATE_DIR/.scan.XXXXXX.json")"
  "$CATT" scan 2>/dev/null \
    | sed -n 's/^\([0-9.]\+\) - \(.*\) - .*$/\2\t\1/p' \
    | jq -R -s 'split("\n") | map(select(length>0) | split("\t"))
                | map({(.[0]): .[1]}) | add // {}' > "$tmp"
  mv -f "$tmp" "$SCAN_CACHE"
}

scan_names() { scan_refresh; jq -r 'keys[]' "$SCAN_CACHE"; }
scan_count() { scan_refresh; jq -r 'length' "$SCAN_CACHE"; }
scan_ip()    { scan_refresh; jq -r --arg n "$1" '.[$n] // ""' "$SCAN_CACHE"; }
scan_candidates() { scan_names | sed 's/^/  - "/; s/$/"/'; }

# --- resolution -------------------------------------------------------------

OVERRIDE="${CAST_DEVICE:-}"

# Print the resolved device NAME, or exit with a diagnostic code.
resolve_name() {
  [[ -n "$OVERRIDE" ]] && { printf '%s\n' "$OVERRIDE"; return 0; }
  ensure_config

  local key dev
  key="$(fingerprint)"
  if [[ "$key" != unknown ]]; then
    dev="$(cfg_network_device "$key")"
    [[ -n "$dev" ]] && { printf '%s\n' "$dev"; return 0; }
  fi

  dev="$(cfg_default_device)"
  [[ -n "$dev" ]] && { printf '%s\n' "$dev"; return 0; }

  # No preference anywhere — fall back to discovery.
  local n; n="$(scan_count)"
  if [[ "$n" -eq 1 ]]; then
    scan_names; return 0
  elif [[ "$n" -eq 0 ]]; then
    die "no Chromecast found on this LAN (catt scan)" 4
  else
    log "cast-resolve: ambiguous — $n Chromecasts on this LAN and no preference set."
    log "  candidates:"; scan_candidates >&2
    log "  fix: cast-resolve register \"<name>\"   (saves this LAN -> device)"
    log "  or:  export CAST_DEVICE=\"<name>\"       (one-off override)"
    exit 3
  fi
}

# Print the resolved device IP (for the native sender), validating presence.
resolve_ip() {
  local name ip
  name="$(resolve_name)" || exit $?
  ip="$(scan_ip "$name")"
  if [[ -z "$ip" ]]; then
    log "cast-resolve: preferred device '$name' not found on this LAN."
    log "  candidates:"; scan_candidates >&2
    exit 5
  fi
  printf '%s\n' "$ip"
}

# --- subcommands ------------------------------------------------------------

do_register() {
  ensure_config
  local name="" label=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --label) label="${2:-}"; shift 2 ;;
      *)       name="$1"; shift ;;
    esac
  done

  # No name given: infer from scan if unambiguous, else fail loud.
  if [[ -z "$name" ]]; then
    local n; n="$(scan_count)"
    if [[ "$n" -eq 1 ]]; then
      name="$(scan_names)"
    elif [[ "$n" -eq 0 ]]; then
      die "no Chromecast found to register (catt scan)" 4
    else
      log "cast-resolve: which device? pass the name explicitly. candidates:"
      scan_candidates >&2; exit 3
    fi
  fi

  local key; key="$(fingerprint)"
  [[ "$key" == unknown ]] && \
    die "cannot identify this LAN (no default-route gateway MAC); connect to the network first"

  config_write --arg k "$key" --arg d "$name" --arg l "$label" \
    '.networks[$k] = ({device:$d} + (if $l=="" then {} else {label:$l} end))
     | (if .default_device=="" then .default_device=$d else . end)'

  # Keep catt's own default in sync so bare `catt` from the terminal agrees.
  "$CATT" -d "$name" set_default >/dev/null 2>&1 \
    || log "cast-resolve: warning — could not sync catt default (catt set_default)"

  log "cast-resolve: registered $key -> '$name'${label:+ (label: $label)} and synced catt default."
}

do_list() {
  ensure_config
  local key def; key="$(fingerprint)"; def="$(cfg_default_device)"
  log "fingerprint   : $key"
  log "default_device: ${def:-<none>}"
  if [[ "$key" != unknown ]]; then
    local m; m="$(cfg_network_device "$key")"
    log "this LAN -> : ${m:-<unmapped, will use default>}"
  else
    log "this LAN -> : <unknown LAN — VPN/no-route — will use default>"
  fi
  log "networks      :"
  jq -r '.networks | to_entries[]
         | "  \(.key) -> \(.value.device)\(if .value.label then " ("+.value.label+")" else "" end)"' "$CONFIG" >&2 \
    || true
  log "scan candidates:"
  scan_candidates >&2 || true
}

# --- dispatch ---------------------------------------------------------------

have jq; have ip
[[ -x "$CATT" ]] || die "catt not found (pipx install catt)"

cmd="${1:-}"
case "$cmd" in
  --device) OVERRIDE="${2:-}"; shift 2; resolve_name ;;
  --ip)     shift; resolve_ip ;;
  register) shift; do_register "$@" ;;
  list)     shift; do_list ;;
  "")       resolve_name ;;
  -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' >&2 ;;
  *)        die "usage: cast-resolve [--ip] | register [name] [--label L] | list" 2 ;;
esac
